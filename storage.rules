rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper: check if file is an image and under 5MB
    function isValidImage() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Helper: get user doc from Firestore
    function getUserData() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function isOwnerOfShop(barbershopId) {
      return request.auth != null
        && getUserData().role == 'owner'
        && getUserData().barbershopId == barbershopId;
    }

    function isDeveloperRole() {
      return request.auth != null
        && getUserData().role == 'developer';
    }

    // User profile photos
    match /users/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && isValidImage();
    }

    // Barbershop photos (logo, gallery, product images, etc.)
    match /barbershops/{barbershopId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && (isOwnerOfShop(barbershopId) || isDeveloperRole())
        && isValidImage();
    }

    // Barber portfolio photos
    match /portfolios/{barberId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == barberId
        && isValidImage();
    }
  }
}
