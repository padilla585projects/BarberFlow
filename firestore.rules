rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function getRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isDeveloper() {
      return isAuth() && getRole() == 'developer';
    }

    function isOwnerOf(barbershopId) {
      return isAuth() && getRole() == 'owner' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.barbershopId == barbershopId;
    }

    function isBarberOf(barbershopId) {
      return isAuth() && getRole() == 'barber' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.barbershopId == barbershopId;
    }

    // Users
    match /users/{userId} {
      // Barber/owner profiles are public to any authenticated user (clients need them for booking)
      allow read: if isAuth() && (request.auth.uid == userId || isDeveloper() || getRole() == 'owner' || getRole() == 'barber' || resource.data.role in ['barber', 'owner']);
      allow create: if isAuth() && request.auth.uid == userId;
      allow update: if isAuth() && (
        request.auth.uid == userId ||
        isDeveloper() ||
        // Owner can manage barbers in their shop:
        // (a) update settings for users already assigned to their shop
        // (b) assign a new user to their shop (only role + barbershopId fields)
        (getRole() == 'owner' && (
          resource.data.get('barbershopId', '') ==
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.barbershopId ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'barbershopId']) &&
           request.resource.data.get('barbershopId', '') ==
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.barbershopId)
        ))
      );
      allow delete: if isDeveloper();

      // Points history subcollection — user reads their own; only Cloud Functions can write
      match /pointsHistory/{entryId} {
        allow read: if isAuth() && request.auth.uid == userId;
        allow write: if false;
      }

      // Barber schedule (clients need to read barber availability for booking)
      match /schedule/{docId} {
        allow read: if isAuth();
        allow write: if isAuth() && (request.auth.uid == userId || isDeveloper());
      }

      // Notifications subcollection (user reads/updates their own)
      match /notifications/{notifId} {
        allow read, update: if isAuth() && request.auth.uid == userId;
        allow create: if isAuth(); // Cloud Functions create via admin SDK, but allow for flexibility
        allow delete: if isAuth() && request.auth.uid == userId;
      }

      // Portfolio subcollection (barber manages, all can read)
      match /portfolio/{photoId} {
        allow read: if isAuth();
        allow create, delete: if isAuth() && request.auth.uid == userId;
      }

      // Schedule templates (barber manages their own)
      match /scheduleTemplates/{templateId} {
        allow read, write: if isAuth() && request.auth.uid == userId;
      }
    }

    // Barbershops
    match /barbershops/{barbershopId} {
      allow read: if isAuth();
      // Owners can create their own barbershop (onboarding) + developers
      allow create: if isDeveloper() || (isAuth() && getRole() == 'owner');
      allow update: if isDeveloper() || isOwnerOf(barbershopId);
      allow delete: if isDeveloper();

      // Services subcollection (clients need to read for booking; owner manages)
      match /services/{serviceId} {
        allow read: if isAuth();
        allow create, update, delete: if isAuth() && (isOwnerOf(barbershopId) || isDeveloper());
      }

      // Payments subcollection (owner pays barbers)
      match /payments/{paymentId} {
        allow read: if isAuth() && (isOwnerOf(barbershopId) || isDeveloper());
        allow create, update: if isAuth() && (isOwnerOf(barbershopId) || isDeveloper());
        allow delete: if isDeveloper();
      }

      // Messages subcollection (internal messaging)
      match /messages/{messageId} {
        allow read: if isAuth() && (
          isOwnerOf(barbershopId) || isBarberOf(barbershopId) || isDeveloper()
        );
        allow create: if isAuth() && (
          isOwnerOf(barbershopId) || isBarberOf(barbershopId) || isDeveloper()
        );
        allow delete: if isDeveloper();
      }

      // Reviews subcollection
      match /reviews/{reviewId} {
        allow read: if isAuth();
        allow create: if isAuth() && request.resource.data.clientId == request.auth.uid;
        allow update: if isAuth() && (
          resource.data.clientId == request.auth.uid || isDeveloper()
        );
        allow delete: if isAuth() && (
          resource.data.clientId == request.auth.uid ||
          isOwnerOf(barbershopId) ||
          isDeveloper()
        );
      }

      // Barber schedules
      match /barberSchedules/{barberId} {
        allow read: if isAuth();
        allow write: if isAuth() && (
          request.auth.uid == barberId || isOwnerOf(barbershopId) || isDeveloper()
        );
      }

      // Barber availability/schedule doc (read/toggled from BarberHomeScreen)
      match /barbers/{barberId} {
        allow read: if isAuth();
        allow write: if isAuth() && (
          request.auth.uid == barberId || isOwnerOf(barbershopId) || isDeveloper()
        );
      }

      // Promo codes subcollection (stored under barbershop, not root)
      match /promos/{promoId} {
        allow read: if isAuth();
        allow create: if isAuth() && (isOwnerOf(barbershopId) || isDeveloper());
        allow update: if isAuth() && (isOwnerOf(barbershopId) || isDeveloper());
        allow delete: if isAuth() && (isOwnerOf(barbershopId) || isDeveloper());
      }
    }

    // Appointments
    match /appointments/{appointmentId} {
      // Any authenticated user can read appointments. This is necessary because
      // clients need to query barbershop+barber+date to calculate available time
      // slots in the booking screen. The app only uses timeSlot and duration
      // from other users' appointments — no client PII is displayed.
      // TODO: For production hardening, replace with a Cloud Function
      // getAvailableSlots() that returns only occupied time slots without
      // exposing the full appointment documents.
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth() && (
        resource.data.clientId == request.auth.uid ||
        isBarberOf(resource.data.barbershopId) ||
        isOwnerOf(resource.data.barbershopId) ||
        isDeveloper()
      );
      allow delete: if isDeveloper() || isOwnerOf(resource.data.barbershopId);
    }

    // Products / Inventory
    match /products/{productId} {
      allow read: if isAuth();
      allow create: if isAuth() && (
        isOwnerOf(request.resource.data.barbershopId) || isDeveloper()
      );
      allow update: if isAuth() && (
        isOwnerOf(resource.data.barbershopId) || isDeveloper() ||
        // Clients can only decrement stock (atomic checkout)
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock']) &&
         request.resource.data.stock < resource.data.stock)
      );
      allow delete: if isAuth() && (
        isOwnerOf(resource.data.barbershopId) || isDeveloper()
      );
    }

    // Sales (POS — created by barber or owner in the shop)
    match /sales/{saleId} {
      allow read: if isAuth() && (
        resource.data.barberId == request.auth.uid ||
        isBarberOf(resource.data.barbershopId) ||
        isOwnerOf(resource.data.barbershopId) ||
        isDeveloper()
      );
      allow create: if isAuth() && (
        isBarberOf(request.resource.data.barbershopId) ||
        isOwnerOf(request.resource.data.barbershopId) ||
        isDeveloper()
      );
      allow update, delete: if isDeveloper() || isOwnerOf(resource.data.barbershopId);
    }

    // Orders (shop purchases by clients)
    match /orders/{orderId} {
      allow read: if isAuth() && (
        resource.data.clientId == request.auth.uid ||
        isOwnerOf(resource.data.barbershopId) ||
        isDeveloper()
      );
      allow create: if isAuth();
      // El cliente puede actualizar su propio pedido (p.ej. autodeclararse
      // "client_confirmed" para Bizum/transferencia), pero NUNCA puede
      // ponerlo en 'paid' él mismo — ese estado solo lo puede escribir el
      // webhook de Stripe (Admin SDK, que ignora estas reglas) o el dueño.
      allow update: if isAuth() && (
        (resource.data.clientId == request.auth.uid &&
          request.resource.data.paymentStatus != 'paid') ||
        isOwnerOf(resource.data.barbershopId) ||
        isDeveloper()
      );
      allow delete: if isDeveloper();
    }

    // Reviews
    match /reviews/{reviewId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.clientId == request.auth.uid;
      allow update: if isAuth() && (
        resource.data.clientId == request.auth.uid || isDeveloper()
      );
      allow delete: if isAuth() && (
        resource.data.clientId == request.auth.uid ||
        isOwnerOf(resource.data.barbershopId) ||
        isDeveloper()
      );
    }

    // Loyalty points (only Cloud Functions / admin SDK can write; users read their own)
    match /loyalty/{docId} {
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid ||
        isOwnerOf(resource.data.barbershopId) ||
        isDeveloper()
      );
      allow create, update, delete: if false;
    }

    // Loyalty settings (owner configures, all authenticated can read)
    match /loyaltySettings/{barbershopId} {
      allow read: if isAuth();
      allow write: if isOwnerOf(barbershopId) || isDeveloper();
    }

    // Promo codes (all auth users can read; owner/dev can write)
    match /promos/{promoId} {
      allow read: if isAuth();
      allow create: if isOwnerOf(request.resource.data.barbershopId) || isDeveloper();
      allow update: if isOwnerOf(resource.data.barbershopId) || isDeveloper();
      allow delete: if isOwnerOf(resource.data.barbershopId) || isDeveloper();
    }

    // Waitlist
    match /waitlist/{entryId} {
      allow read: if isAuth() && (
        resource.data.clientId == request.auth.uid ||
        isOwnerOf(resource.data.barbershopId) ||
        isBarberOf(resource.data.barbershopId) ||
        isDeveloper()
      );
      allow create: if isAuth();
      allow update: if isAuth() && (
        resource.data.clientId == request.auth.uid ||
        isOwnerOf(resource.data.barbershopId) ||
        isDeveloper()
      );
      allow delete: if isAuth() && (
        resource.data.clientId == request.auth.uid ||
        isOwnerOf(resource.data.barbershopId) ||
        isDeveloper()
      );
    }

    // Notifications (each user reads their own)
    match /notifications/{notifId} {
      allow read: if isAuth() && resource.data.userId == request.auth.uid;
      allow create: if isDeveloper();
      allow update: if isAuth() && resource.data.userId == request.auth.uid;
      allow delete: if isAuth() && resource.data.userId == request.auth.uid;
    }

    // Barber applications (barber submits, owner reviews)
    match /barber_applications/{appId} {
      // The applicant can read their own; owner of the target barbershop can read all theirs
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid ||
        isOwnerOf(resource.data.barbershopId) ||
        isDeveloper()
      );
      // Any authenticated barber can create an application
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      // Owner updates status (approve/reject); developer can too
      allow update: if isAuth() && (
        isOwnerOf(resource.data.barbershopId) || isDeveloper()
      );
      allow delete: if isDeveloper();
    }

    // Analytics events (cualquier usuario autenticado puede escribir eventos)
    match /analytics_events/{eventId} {
      allow create: if isAuth();
      allow read, update, delete: if isDeveloper();
    }

    // Invitaciones de barberos (el owner genera el código, el barber lo consume)
    match /invitations/{code} {
      allow read: if isAuth();
      allow create: if isAuth() && (isDeveloper() || getRole() == 'owner');
      allow update: if isAuth();
      allow delete: if isDeveloper();
    }
  }
}
